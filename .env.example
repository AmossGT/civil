POSTGRES_DB=tenders
POSTGRES_USER=tender
POSTGRES_PASSWORD=tender
SECRET_KEY=change-this-local-secret-key-before-deploying
UPLOAD_DIR=/app/uploads
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:5173
COOKIE_SECURE=false
MAX_UPLOAD_BYTES=15728640
# Configure SMTP to deliver the one-time first-admin email verification code.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
LOAD_PROTOTYPE_DATA=true
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
